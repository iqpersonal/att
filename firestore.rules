rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isTenantMember(tenantId) {
      return (request.auth.token.tenantId == tenantId) ||
             exists(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
             get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription_tier', 'credits_remaining', 'email']);
    }

    // History collection
    match /history/{docId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Root students collection (for dashboard access)
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Root leads collection (for app-level access)
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /activities/{activityId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // Tenants collection - Root document read for initialization
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (
        isTenantMember(tenantId) ||
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.tenantId == tenantId
      );
      allow write: if isTenantMember(tenantId);

      match /leads/{leadId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isSignedIn() && isTenantMember(tenantId);
        allow update: if isTenantMember(tenantId);
        allow delete: if isTenantMember(tenantId);
      }

      match /students/{studentId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isSignedIn() && isTenantMember(tenantId);
        allow update: if isTenantMember(tenantId);
        allow delete: if isTenantMember(tenantId);
      }

      match /conversations/{docId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isSignedIn() && isTenantMember(tenantId);
        allow update: if isTenantMember(tenantId);
        match /messages/{msgId} {
          allow read: if isTenantMember(tenantId);
          allow create: if isSignedIn() && isTenantMember(tenantId);
          allow update: if isTenantMember(tenantId);
        }
      }

      match /message_history/{docId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isSignedIn() && isTenantMember(tenantId);
      }

      match /config/{docId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId);
      }

      match /integrations/{docId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId);
      }

      match /members/{userId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId);
      }
    }
  }
}
